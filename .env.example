# Copy to .env (never commit .env). Values are shared privately by Part 1.
# In Vercel → Project → Settings → Environment Variables, set the same names for Production + Preview.
# No VITE_ prefixes: vite.config.ts exposes ONLY the two public Supabase values to the browser.

# --- Public (end up in the browser bundle; RLS limits anon to verified rows + catalog_stats counts) ---
SUPABASE_URL=                 # https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=            # Supabase → Project Settings → API → anon / publishable key

# --- SERVER-ONLY (read by api/* and src/server/* — never imported by client code) ---
SUPABASE_SERVICE_ROLE_KEY=    # server-only: bypasses RLS; used by /api/curate-write + /api/curate-cards
GROQ_API_KEY=                 # server-only: LLM primary
GEMINI_API_KEY=               # server-only: LLM failover (optional but recommended)
LLM_PROVIDER_ORDER=groq,gemini  # server-only: try order, comma-separated
CURATOR_SECRET=               # server-only: shared secret for /curate (x-curator-secret); long + random

# --- Optional, server-only: pin models (defaults in src/server/llm.ts) ---
# GROQ_MODEL=llama-3.3-70b-versatile
# GEMINI_MODEL=gemini-2.5-flash

# --- Tests only. NEVER set in .env / Vercel. ---
# IGNIS_DB_TESTS=1  → consent for tests/db/* to write + delete rows; honored for LOCAL databases only
#                    (remote needs IGNIS_DB_TESTS_REMOTE=<project-ref> on the command line). Only scripts/local-db.mjs sets it
#                    (in .env.disposable) or a deliberately disposable test project.
