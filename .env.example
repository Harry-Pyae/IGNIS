# Copy to .env (never commit .env). Values are shared privately by Part 1.
# Set the same vars in Vercel → Project → Settings → Environment Variables (Production + Preview).

# --- Public (safe in the browser bundle; RLS limits anon to verified rows) ---
SUPABASE_URL=                 # https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=            # anon/public key

# --- SERVER-ONLY (never prefix with VITE_, never import in src/ client code) ---
SUPABASE_SERVICE_ROLE_KEY=    # server-only: bypasses RLS; used by /api/curate-write
GROQ_API_KEY=                 # server-only: LLM primary
GEMINI_API_KEY=               # server-only: LLM failover
LLM_PROVIDER_ORDER=groq,gemini  # server-only: try order, comma-separated
CURATOR_SECRET=               # server-only: shared secret for /api/extract + /api/curate-write

# --- Optional, server-only: pin models (defaults in src/server/llm.ts) ---
# GROQ_MODEL=llama-3.3-70b-versatile
# GEMINI_MODEL=gemini-2.5-flash
